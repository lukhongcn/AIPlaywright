{
  "actions": [
    {
      "action": "login_test",
      "description": "測試登入 MES 系統。當用戶明確要求測試登入、驗證帳號密碼是否可登入、檢查登入頁是否正常時，選擇 login_test。",
      "readonly": true,
      "riskLevel": "low",
      "requiredParams": [
        "userName",
        "password"
      ],
      "optionalParams": [
        "loginUrl"
      ],
      "defaults": {
        "loginPath": "/Login.aspx"
      }
    },
    {
      "action": "order_design_new_dryrun",
      "description": "新增訂單設計 dry-run：打開訂單設計列表頁，點新增，填寫欄位，但不保存。當用戶說「新增訂單」「建立訂單」「新建訂單」「開訂單」「新增一張訂單」時，應選擇 order_design_new_dryrun，而不是 rejected，也不要編排 login_test；登入由程序依 requiresLogin 自動處理。",
      "readonly": false,
      "riskLevel": "medium",
      "requiresLogin": true,
      "dryRunOnly": true,
      "allowTechnicalPostback": true,
      "businessCommitAllowed": false,
      "requiredParams": [],
      "optionalParams": [
        "customer",
        "itemNo",
        "quantity",
        "orderDate",
        "deliveryDate",
        "remark"
      ],
      "defaults": {
        "entryPagePath": "/order/OrderDesignList.aspx",
        "entryAction": "click_new"
      },
      "allowedUiEffects": [
        "postback",
        "dropdown_change",
        "field_validation",
        "auto_fill",
        "query_lookup",
        "grid_refresh",
        "open_edit_page"
      ],
      "forbiddenButtonTexts": [
        "保存",
        "儲存",
        "存檔",
        "提交",
        "送出",
        "審核",
        "反審核",
        "過帳",
        "刪除",
        "確定",
        "确认",
        "OK",
        "批量更新"
      ]
    }
  ]
}
